{
	"browser": {
		"browserName": "chromium",
		"launchOptions": {
			"headless": true,
			"args": [
				"--use-fake-ui-for-media-stream",
				"--use-fake-device-for-media-stream",
				"--use-file-for-fake-audio-capture=.playwright/mic.wav"
			]
		},
		"contextOptions": {
			"permissions": ["microphone"],
			"viewport": { "width": 390, "height": 844 },
			"isMobile": true,
			"hasTouch": true,
			"deviceScaleFactor": 2
		}
	}
}
